# Template for backend/.env  (names only; this file is safe to commit and contains no values).
#
#   1. Copy this file to backend/.env       (copy backend\.env.example backend\.env)
#   2. Fill in YOUR OWN values after the = sign, with no quotation marks unless the value contains a space.
#   3. backend/.env is ignored by Git and by Docker. Never commit it, paste it into a chat, or upload it.
#
# Real environment variables always win over this file, so on Azure App Service do NOT upload a .env file:
# enter the same names by hand under Settings > Environment variables > App settings.
# A line left blank leaves that feature off. The app runs fully with every line blank.

# --- "Why might this be happening?" (optional AI explanations; without a key the curated text is used) ---
OPENAI_API_KEY=
OPENAI_EXPLANATION_MODEL=

# --- Meteomatics live weather (optional; both are needed; without them /api/live-weather reports "unconfigured") ---
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# --- Live news (optional; the default GDELT source needs no key) ---
NEWS_PROVIDER=
NEWS_API_KEY=

# --- Hosting (optional) ---
# Secret used to sign case_signature tokens. Set it on any host that restarts or runs several copies.
TD_CASE_SECRET=
# Extra browser origins allowed by CORS, comma separated.
TD_ALLOWED_ORIGINS=

# Other tunables (timeouts, cache lifetimes, rate limits) are listed with their defaults in docs/V2_BACKEND_HANDOFF.md;
# add any of them here the same way, for example:  OPENAI_TIMEOUT_SECONDS=20
